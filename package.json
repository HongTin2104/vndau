{
  "name": "vndau",
  "version": "0.1.1",
  "description": "Normalize Vietnamese tone marks (hoà/hòa, thuỷ/thủy), fix NFD text, strip diacritics, slugify.",
  "keywords": [
    "vietnamese",
    "tieng-viet",
    "unicode",
    "normalize",
    "diacritics",
    "slugify",
    "tone-marks"
  ],
  "license": "MIT",
  "author": "HongTin2104",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HongTin2104/vndau.git"
  },
  "homepage": "https://github.com/HongTin2104/vndau#readme",
  "bugs": "https://github.com/HongTin2104/vndau/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vndau": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm run coverage",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
